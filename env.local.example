# 実環境固有の値。このファイルをコピーして env.local を作る。
#   cp env.local.example env.local
#
# env.local は .gitignore 済み。実アカウント ID や組織の SSO URL は
# コミット対象のファイルには書かない (リポジトリが公開される可能性があるため)。
#
# scripts/*.sh がこのファイルを読む。

# --- アカウント A: 呼び出す側 / 開発メンバー共有の検証環境 ---
ACCOUNT_A_ID=000000000000
PROFILE_A=account-a-profile

# --- アカウント B: 呼び出される側 / 各自の AWS アカウント ---
ACCOUNT_B_ID=000000000000
PROFILE_B=account-b-profile

# --- リソースの作成者識別子 (英小文字・数字・ハイフン 1〜21 文字) ---
OWNER=yourname

# --- IAM Identity Center (scripts/setup-sso.sh 用) ---
# start URL は AWS アクセスポータルの URL
SSO_START_URL=https://example.awsapps.com/start
# Identity Center インスタンスの所在リージョン (リソースのリージョンとは別)
SSO_REGION=us-east-1
# 許可セット名 (AWSReservedSSO_<これ>_<hash> というロール名になっている部分)
SSO_PERMISSION_SET=YourPermissionSet

# --- リソースを作るリージョン ---
AWS_RESOURCE_REGION=ap-northeast-1
